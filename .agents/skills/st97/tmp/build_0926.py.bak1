import json,re
src=open('../../../../聖書（新改訳2017）/歴代誌第一.md',encoding='utf-8').read()
ch=src.split('## 15章')[1].split('## 16章')[0]
V={}
for m in re.finditer(r'^(\d+)　(.+?) \^15-\d+$',ch,re.M): V[int(m.group(1))]=m.group(2)
assert sorted(V)==list(range(1,30)),sorted(V)
def vt(a,b=None):
    if b is None: return V[a]
    return "\n".join(f"{i}　{V[i]}" for i in range(a,b+1))
def lab(a,b=None): return f"歴代誌第一15:{a}" if b is None else f"歴代誌第一15:{a}〜{b}"
def v(a,notes,b=None): return {"label":lab(a,b),"text":vt(a,b),"notes":notes}
